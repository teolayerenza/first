# Copiá este archivo a .env.local. SIN estas variables la app corre en MODO DEMO (datos simulados).

# ── Supabase (públicas: van al navegador; solo dan acceso de lectura a las vistas) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Cloudflare Turnstile (captcha invisible) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Sitio ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mapa base (opcional; por defecto OpenFreeMap) ──
# NEXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# ⚠️ NUNCA pongas acá la service role ni el HMAC_SECRET: viven SOLO como secretos de la Edge Function
#    (supabase secrets set HMAC_SECRET=... TURNSTILE_SECRET=... ALLOWED_ORIGIN=https://pocitoslp.com.ar)
